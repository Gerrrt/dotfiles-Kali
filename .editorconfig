# .editorconfig — house style for dotfiles-Kali.
# https://editorconfig.org — honored natively by Neovim (this repo's editor),
# VS Code, and most others.
#
# EDIT-TIME ONLY. Nothing in CI enforces formatting here: the gates are shellcheck +
# `bash -n` / `zsh -n` (real bugs) and markdownlint (docs structure). shfmt is
# deliberately advisory in the fleet lint workflow because it would expand the
# compact one-liner style bootstrap.sh's arg loop uses on purpose. So this file's job
# is narrow — keep new edits consistent, not to retroactively reformat anything.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Shell — 2-space, matching bootstrap.sh and scripts/.
# (offensive/tmux/tmux-eng.sh predates this and is tab-indented; it is left alone
# rather than reflowed, since a whitespace-only rewrite would bury its history.)
[*.{sh,zsh}]
indent_size = 2

[*.{yml,yaml,json,jsonc,toml}]
indent_size = 2

# Markdown — trailing double-space is a hard line break, so trimming it silently
# changes rendering. markdownlint governs structure; leave whitespace alone.
[*.md]
trim_trailing_whitespace = false

# The vim-folded field references (hacktheplanet / exploitdev / evasion / ippsec) are
# extensionless, hand-aligned command sheets whose columns carry meaning. Do not let
# an editor retab or trim them.
[{hacktheplanet,exploitdev,evasion,ippsec}]
trim_trailing_whitespace = false
insert_final_newline = false

[Makefile]
indent_style = tab
