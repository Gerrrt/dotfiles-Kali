# install/tools.lst — the host-tool shopping list, and the ONE place it is written.
#
# `bootstrap.sh` reads column 1 of this file to decide what to probe. Twin of
# dotfiles-Defense/install/tools.lst, and for the same reason: the set used to exist
# only as a literal inside bootstrap.sh, so nothing kept it in step with what
# offensive/offensive.zsh actually calls.
#
# FORMAT: one entry per line, `<command>` then an optional `# note`. Blank lines and
# comment-only lines are ignored. Column 1 is the COMMAND the probe looks for, which
# is often NOT the package name — Kali packages ProjectDiscovery's httpx as
# `httpx-toolkit`, impacket as ~60 `impacket-*` scripts, sliver's client as
# `sliver-client`. install/offensive-packages.txt carries the apt names.
#
# THIS FILE IS THE PROBE LIST, NOT AN INSTALL LIST. The default bootstrap installs
# nothing: your OS-native layer (dotfiles-Debian, which now covers Kali) owns packages,
# and `./bootstrap.sh --install` is the opt-in that reads offensive-packages.txt.
# Adding a line here adds it to the report, nothing more.
#
# WHAT BELONGS HERE: a command offensive/offensive.zsh probes with HAVE_* or invokes by
# bare name. A tool the cheatsheets merely mention does not — the report would then warn
# about things this layer never calls, and a report that cries wolf gets ignored.
#
# zsh leads deliberately: it is the shell this entire layer runs in, so its absence is
# categorically worse than a missing offensive tool, and bootstrap's end-of-run guard
# says so loudly.

zsh                     # the shell this layer runs in — not optional
python3                 # backs hethttp's `python3 -m http.server`
tmux                    # the `prefix + e` engagement popup and tmux-eng.sh

# ── Network / Active Directory ────────────────────────────────────────────────
nxc                     # NetExec (apt: netexec) — backs the smb/ldap/winrm aliases and bhce
nmap                    # nmapsweep
responder
evil-winrm
certipy-ad              # AD CS abuse (ESC1-ESC17)
impacket-secretsdump    # apt: impacket-scripts — one canonical entrypoint of ~60
# The CE collector, installed by apt `bloodhound-ce-python` OR pipx `bloodhound-ce` — both
# ship this exact binary. The legacy (≤4.3.1) collector's binary is `bloodhound-python`; it is
# deliberately NOT an accepted alt-name in bootstrap.sh, because its zips don't ingest into CE.
bloodhound-ce-python

# ── Web / recon ───────────────────────────────────────────────────────────────
nuclei                  # also a redup fast-mover
httpx-toolkit           # ProjectDiscovery httpx; bare `httpx` is the python lib
katana
bbot
ffuf
feroxbuster
gobuster
amass

# ── C2 / emulation ────────────────────────────────────────────────────────────
sliver-client           # apt: sliver — backs the `sliver` alias
msfconsole              # apt: metasploit-framework — backs the `msf` alias

# ── Cracking ──────────────────────────────────────────────────────────────────
hashcat
john                    # apt: john (john-the-ripper)

# ── Inspection / plumbing ─────────────────────────────────────────────────────
hexyl                   # hex viewer; detect-only (dotgibson/dotfiles-core#395)
searchsploit            # apt: exploitdb — redup refreshes its exploit-DB
script                  # util-linux; logshell's audit-trail recorder
