// .markdownlint.jsonc — house style for this repo's showcase README.
//
// This is a public OS-native layer, so its README is a deliverable landing page
// and its markdown is worth linting. Run it with markdownlint-cli2 (the same
// linter and rule set dotfiles-core uses for its own README):
//
//     npx --yes markdownlint-cli2 README.md
//
// The vendored core/ tree is deliberately NOT linted here — it is a read-only
// copy of dotfiles-core, gated by that repo's own CI; a finding there is fixed
// upstream, not in this repo. This config is the local check for the README,
// mirrored from Core; CI here gates this repo's own code, not its Markdown.
//
// Two rules are deliberately off; everything else (the default rule set) stays
// on to catch real structural defects — bad headings, broken lists, and the
// stray-HTML / leaked-template-tag class of bug this config exists to catch.
{
  "default": true,

  // MD013 (line-length): OFF. Prose wraps by sentence, not column, and the docs
  // use wide GitHub tables — a long line is not a defect here.
  "MD013": false,

  // MD041 (first-line-h1): OFF. The README opens with a centered badge/logo HTML
  // block, not a top-level H1, which is the intended showcase layout.
  "MD041": false,

  // MD024 (no-duplicate-heading): SIBLINGS ONLY. Still catches a true duplicate
  // (two identical headings under the SAME parent) while allowing repeated
  // subsection names under different parents.
  "MD024": { "siblings_only": true },

  // MD033 (no-inline-html): SCOPED, not off. The README legitimately uses HTML
  // the CommonMark spec can't express — centered badge rows, the logo block, a
  // collapsible table of contents, back-to-top links. allowed_elements lists
  // exactly the tags that design needs, so the rule still fires on ANYTHING else
  // — the leaked-template-tag class of bug. Keep this list tight.
  "MD033": {
    "allowed_elements": [
      "a", "br", "details", "div", "h3", "img", "li", "nobr", "ol", "p", "strong", "summary", "ul"
    ]
  },

  // MD060 (table-column-style): OFF. Every table in this repo is written compact
  // (`| a | b |` with a `|---|---|` delimiter row) and has been since the first
  // commit. The rule wants uniform padding to the widest cell, which on
  // PURPLE-TEAM's wide detection tables means reflowing hundreds of rows to change
  // nothing a reader sees. 58 of the 112 findings on first run were this one rule.
  // It is a formatting preference, not a defect class — MD013 is off here for the
  // same reason.
  "MD060": false,

  // MD036 (no-emphasis-as-heading): OFF, and this one is not a preference — it is a
  // boundary. Every instance is a `**Detect <technique> (event IDs)**` label inside
  // a `<!-- companion:gen -->` block in PURPLE-TEAM.md, i.e. output of
  // offensive/companion/gen-views.sh, which is vendored from dotgibson/htpx. All 23
  // findings were generated content. Hand-fixing them would fail the companion drift
  // gate (companion.yml runs gen-views.sh --check); the real fix is to change the
  // renderer upstream in htpx, at which point this line should come back out.
  "MD036": false
}
