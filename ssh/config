# dotfiles-Kali/ssh/config  ->  ~/.ssh/config   (symlinked, mode 600)
# Hardened defaults + connection multiplexing. Host-specific secrets and real
# hostnames do NOT belong here — keep those in ~/.ssh/config.local (untracked)
# and they'll be picked up by the Include below.
#
# ORDERING MATTERS: ssh takes the FIRST value it obtains for each keyword, so this
# file goes most-specific → least-specific. The Include is first so a local override
# beats everything here; `Host *` is last so it only fills in what nothing else set.
#
# ── A NOTE ON CRYPTO, SPECIFIC TO THIS BOX ────────────────────────────────────
# Pinning modern-only KexAlgorithms/Ciphers/MACs on `Host *` is the right default on
# a normal workstation. It is the WRONG default on an offensive one: half of what you
# ssh into during an engagement is a decade-old appliance or an intentionally
# vulnerable lab box, and a global pin turns those into
# "no matching key exchange method found" — a failure that reads like the target is
# broken rather than like your client refused. So the strict set is scoped to the
# infrastructure where it actually protects something (your own accounts), and
# targets get stock OpenSSH negotiation.

Include ~/.ssh/config.local

# ── your own infrastructure — strict crypto belongs HERE ─────────────────────
Host github.com gitlab.com
    User git
    IdentitiesOnly yes
    # IdentityFile ~/.ssh/id_ed25519
    KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512
    Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

# Add your own servers to this pattern (or to ~/.ssh/config.local) to get the same
# strict set. Keep TARGETS out of it.
# Host *.your-domain.example
#     KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512
#     Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
#     MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

# ── everything else, targets included ────────────────────────────────────────
# Non-crypto hardening + ergonomics only. No algorithm pinning: let OpenSSH
# negotiate, so a legacy target connects instead of erroring out.
Host *
    AddKeysToAgent yes
    HashKnownHosts yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    # connection reuse — faster repeat logins
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 600

# ── connecting to something genuinely ancient ────────────────────────────────
# Even stock OpenSSH now refuses ssh-rsa/SHA-1 and diffie-hellman-group1. When a
# target needs them, re-enable per connection rather than weakening this file:
#   ssh -o KexAlgorithms=+diffie-hellman-group1-sha1 \
#       -o HostKeyAlgorithms=+ssh-rsa \
#       -o PubkeyAcceptedAlgorithms=+ssh-rsa user@target
# The `+` form ADDS to the default set for that one invocation.

# ── templates: copy into ~/.ssh/config.local and fill in ──────────────────────
# Host bastion
#     HostName 203.0.113.10
#     User jump
#     IdentityFile ~/.ssh/id_ed25519
#
# Host lab-internal
#     HostName 10.10.10.5
#     User kali
#     ProxyJump bastion
#
# Host vps
#     HostName your.vps.example
#     User you
#     IdentityFile ~/.ssh/id_ed25519
