# .gitattributes — line-ending policy for dotfiles-Offense.
# ──────────────────────────────────────────────────────────────────────────────
# .editorconfig sets `end_of_line = lf`, but that only guides EDITORS — it does not
# govern what git writes on checkout/commit. This repo is WSL2-targeted, which means
# the working tree is routinely reachable from Windows (\\wsl$\, or a clone made with
# Git for Windows), where git can introduce CRLF. A `.sh` with CRLF gets a shebang of
# `…/env bash\r` and dies with "bad interpreter: No such file or directory" — text
# that looks perfectly valid, and that shellcheck and `bash -n` both accept.
#
# `text=auto eol=lf`: git auto-detects text vs binary, normalizes text to LF in the
# repo, and checks it out as LF on every OS. The explicit blocks pin the load-bearing
# classes so detection is never in play for them.

# Default: normalize all detected-text files to LF in the index and on checkout.
* text=auto eol=lf

# ── Executable + sourced shell — MUST stay LF or the shebang/sourcing breaks ───
*.sh        text eol=lf
*.zsh       text eol=lf
*.py        text eol=lf

# ── The extensionless field references and the companion browser ──────────────
# No extension means no auto-detection to rely on, and hacktheplanet et al. are
# opened in vim with a modeline; htpx is executable.
offensive/hacktheplanet     text eol=lf
offensive/exploitdev        text eol=lf
offensive/evasion           text eol=lf
offensive/ippsec            text eol=lf

# ── Config / data ─────────────────────────────────────────────────────────────
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.conf      text eol=lf
*.gitconfig text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.env       text eol=lf
Makefile    text eol=lf

# ── Binaries (defensive): never normalize, never diff as text ─────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.gz        binary
*.zip       binary
*.tar       binary
*.pcap      binary
